<UserControl x:Class="RDC2_0064.Measurements"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RDC2_0064"
             mc:Ignorable="d">
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <StackPanel Margin="0,0,25,0">
                <CheckBox x:Name="EnableCheck" Content="Enable" Margin="0,5,0,0" Checked="Enable_Checked" Unchecked="Enable_UnChecked" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Label Content="M20 input" Style="{StaticResource LabelStyle}" VerticalAlignment="Top"/>
            </StackPanel>
            <GroupBox x:Name="RangeGroup" Header="Frequency range" IsEnabled="False">
                <ItemsControl x:Name="RangeItmes" Style="{StaticResource ItemsControlStyle}"/>
            </GroupBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
            <Label Content="Width:" Style="{StaticResource LabelStyle}" Margin="0,0,3,0"/>
            <Label x:Name="PulseWidth" Content="0" Style="{StaticResource LabelStyle}" Margin="0,0,3,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
            <Label Content="Period:" Style="{StaticResource LabelStyle}" Margin="0,0,3,0"/>
            <Label x:Name="PulsePeriod" Content="0" Style="{StaticResource LabelStyle}" Margin="0,0,3,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
            <Label Content="Duty cycle:" Style="{StaticResource LabelStyle}" Margin="0,0,3,0"/>
            <Label x:Name="PulseDutyCycle" Content="0" Style="{StaticResource LabelStyle}" Margin="0,0,3,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
            <Label Content="Frequency:" Style="{StaticResource LabelStyle}" Margin="0,0,3,0"/>
            <Label x:Name="PulseFrequency" Content="0" Style="{StaticResource LabelStyle}" Margin="0,0,3,0"/>
        </StackPanel>
    </StackPanel>
</UserControl>
