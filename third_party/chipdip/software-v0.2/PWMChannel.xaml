<UserControl x:Class="RDC2_0064.PWMChannel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RDC2_0064"
             mc:Ignorable="d">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
        <CheckBox IsChecked="{Binding IsActive}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        <Label Content="{Binding Title}" Width="30" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="0" Margin="5,0,0,0"/>
        <Label Content="Duty cycle, %" Margin="0" Style="{StaticResource LabelStyle}"/>
        <ComboBox ItemsSource="{Binding DutyCycleTable}" SelectedItem="{Binding DutyCycle}" Width="50" Margin="5,0,0,0"/>
    </StackPanel>
</UserControl>
