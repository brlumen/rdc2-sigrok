<UserControl x:Class="RDC2_0064.LogicAnalyzer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RDC2_0064"
             mc:Ignorable="d">
    <StackPanel Orientation="Horizontal">
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
            <GroupBox Header="Sampling mode" Style="{StaticResource GroupBoxStyle}" HorizontalAlignment="Left" Width="135">
                <ItemsControl x:Name="ModeItems" Style="{StaticResource ItemsControlStyle}"/>
            </GroupBox>
            <GroupBox Header="Active channels" Style="{StaticResource GroupBoxStyle}" HorizontalAlignment="Left" Width="135">
                <ItemsControl x:Name="ChannelsItems" Style="{StaticResource ItemsControlStyle}"/>
            </GroupBox>
        </StackPanel>
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,0,0,0">
            <GroupBox Header="Trigger setting">
                <StackPanel Orientation="Horizontal">
                    <StackPanel x:Name="Stage1TriggerPanel">
                        <CheckBox x:Name="TriggerActivation" Content="Stage 1" Checked="TriggerActivation_Checked" Unchecked="TriggerActivation_Unchecked" Margin="0,5,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <StackPanel Style="{StaticResource TriggerLabelStackPanelStyle}">
                            <Label Content="0" Style="{StaticResource TriggerLabelStyle}"/>
                            <Label Content="7" Style="{StaticResource TriggerLabelStyle}" Margin="127,0,0,0"/>
                        </StackPanel>
                        <ItemsControl x:Name="TrigItems0_7" Style="{StaticResource ItemsControlStyle}" FlowDirection="RightToLeft">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedIndex="{Binding Path= SelectedTrigger}" ItemsSource="{Binding Path= TriggerStrings}" xmlns:sys="clr-namespace:System;assembly=mscorlib" Style="{StaticResource TriggerComboBoxStyle}">
                                        <ComboBox.Resources>
                                            <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">0</sys:Double>
                                        </ComboBox.Resources>
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <Image Source="{Binding}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Style="{StaticResource TriggerLabelStackPanelStyle}">
                            <Label Content="8" Style="{StaticResource TriggerLabelStyle}"/>
                            <Label Content="15" Style="{StaticResource TriggerLabelStyle}" Margin="120,0,0,0"/>
                        </StackPanel>
                        <ItemsControl x:Name="TrigItems8_15" Style="{StaticResource ItemsControlStyle}" FlowDirection="RightToLeft">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedIndex="{Binding Path= SelectedTrigger}" ItemsSource="{Binding Path= TriggerStrings}" xmlns:sys="clr-namespace:System;assembly=mscorlib" Style="{StaticResource TriggerComboBoxStyle}">
                                        <ComboBox.Resources>
                                            <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">0</sys:Double>
                                        </ComboBox.Resources>
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <Image Source="{Binding}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Style="{StaticResource TriggerLabelStackPanelStyle}">
                            <Label Content="16" Style="{StaticResource TriggerLabelStyle}"/>
                            <Label Content="23" Style="{StaticResource TriggerLabelStyle}" Margin="116,0,0,0"/>
                        </StackPanel>
                        <ItemsControl x:Name="TrigItems16_23" Style="{StaticResource ItemsControlStyle}" FlowDirection="RightToLeft">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedIndex="{Binding Path= SelectedTrigger}" ItemsSource="{Binding Path= TriggerStrings}" xmlns:sys="clr-namespace:System;assembly=mscorlib" Style="{StaticResource TriggerComboBoxStyle}">
                                        <ComboBox.Resources>
                                            <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">0</sys:Double>
                                        </ComboBox.Resources>
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <Image Source="{Binding}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Style="{StaticResource TriggerLabelStackPanelStyle}">
                            <Label Content="24" Style="{StaticResource TriggerLabelStyle}"/>
                            <Label Content="31" Style="{StaticResource TriggerLabelStyle}" Margin="116,0,0,0"/>
                        </StackPanel>
                        <ItemsControl x:Name="TrigItems24_31" Style="{StaticResource ItemsControlStyle}" FlowDirection="RightToLeft">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedIndex="{Binding Path= SelectedTrigger}" ItemsSource="{Binding Path= TriggerStrings}" xmlns:sys="clr-namespace:System;assembly=mscorlib" Style="{StaticResource TriggerComboBoxStyle}">
                                        <ComboBox.Resources>
                                            <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">0</sys:Double>
                                        </ComboBox.Resources>
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <Image Source="{Binding}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>
                    <StackPanel HorizontalAlignment="Left" Margin="5,0,0,0">
                        <Label Content="Stage 2" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Label Content="EDGE" Margin="0,0,5,0" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="EdgeTriggerSelector" SelectedIndex="{Binding Path= EdgeTrigger.SelectedTrigger}" ItemsSource="{Binding Path= EdgeTrigger.TriggerStrings}" xmlns:sys="clr-namespace:System;assembly=mscorlib" Style="{StaticResource TriggerComboBoxStyle}" Margin="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <ComboBox.Resources>
                                    <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">0</sys:Double>
                                </ComboBox.Resources>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>
        <StackPanel Margin="5,0,0,0">
            <GroupBox Header="Sampling setting">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ComboBox x:Name="SampleCountSelector" Width="100" Padding="4,3,0,3" SelectionChanged="SampleSettingsChanged"/>
                        <Label Content="@"/>
                        <ComboBox x:Name="SampleFreqSelector" Width="80" SelectionChanged="SampleSettingsChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Label Content="Sampling time:" Margin="0,0,5,0" Style="{StaticResource LabelStyle}"/>
                        <Label x:Name="SampleTimeLabel" Margin="0" Style="{StaticResource LabelStyle}"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Center">
                <Button x:Name="StartButton" Click="StartButton_Click" Width="32" Height="32">
                    <Image Source="images/start_32x32.png" Stretch="UniformToFill"/>
                </Button>
                <Button x:Name="StopButton" Click="StopButton_Click" Width="32" Height="32" Margin="20,0,0,0">
                    <Image Source="images/stop_32x32.png" Stretch="UniformToFill"/>
                </Button>
                <Button x:Name="SaveButton" Margin="80,0,0,0" Click="SaveButton_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="32" IsEnabled="False">
                    <Image Source="images/save_32x32.png" Stretch="UniformToFill"/>
                </Button>
            </StackPanel>
            <Grid Margin="0,10,0,0">
                <ProgressBar x:Name="ProcessStatus" Cursor="Arrow" Height="20" />
                <TextBlock x:Name="ProgressValueBlock" Text="{Binding Value, ElementName=ProcessStatus, StringFormat=\{0:0\}%}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <StackPanel x:Name="StreamFilePanel" Orientation="Horizontal" Margin="0,5,0,0">
                <Label Content="Stream to:" Margin="0,0,5,0" Style="{StaticResource LabelStyle}"/>
                <Label x:Name="StreamFilePathLabel" Margin="0" Style="{StaticResource LabelStyle}" Width="137"/>
                <Button x:Name="StreamFileButton" Content="..." HorizontalAlignment="Left" VerticalAlignment="Top" Click="ChooseStreamFileButton_Click" Width="16" IsEnabled="False" Height="20"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
