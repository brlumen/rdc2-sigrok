<UserControl x:Class="RDC2_0064.Generators"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RDC2_0064"
             mc:Ignorable="d">
    <StackPanel Orientation="Horizontal">
        <GroupBox Header="PWM 1">
            <local:PWM x:Name="PWM1"/>
        </GroupBox>
        <StackPanel>
            <GroupBox Header="PWM 2" Margin="5,0,0,0" VerticalAlignment="Top">
                <local:PWM x:Name="PWM2"/>
            </GroupBox>
            <Button x:Name="ApplyButton" Content="Apply" HorizontalAlignment="Center" VerticalAlignment="Center" Click="ApplyButton_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>
