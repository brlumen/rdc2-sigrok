From 3259b1f40daa6e3837ae1b46929a9c8dcdad0fd1 Mon Sep 17 00:00:00 2001
From: BrLumen <igflocal@gmail.com>
Date: Sun, 6 Sep 2026 20:06:32 +0700
Subject: [PATCH] DeviceManager: don't drop open devices during a driver scan

driver_scan() removes every device of the driver from the device list
before scanning, assuming the scan will find them again. A device that is
currently open in a session cannot always be probed again: serial drivers
hold the port exclusively, so the scan fails with "Resource busy" and the
open device silently disappears from the list, leaving the session with
an orphaned device and "<No Device>" for new sessions.

Keep devices that are open, skip newly scanned instances that refer to
the same connection (drivers that do not lock their transport find the
device again), and return the kept devices together with the new ones so
that the connect dialog still lists them. Add HardwareDevice::is_open()
for that.

Signed-off-by: BrLumen <igflocal@gmail.com>
---
 pv/devicemanager.cpp          | 40 ++++++++++++++++++++++++++++++-----
 pv/devices/hardwaredevice.cpp |  5 +++++
 pv/devices/hardwaredevice.hpp |  5 +++++
 3 files changed, 45 insertions(+), 5 deletions(-)

diff --git a/pv/devicemanager.cpp b/pv/devicemanager.cpp
index 09d9014b..bc173e3b 100644
--- a/pv/devicemanager.cpp
+++ b/pv/devicemanager.cpp
@@ -20,6 +20,7 @@
 #include "devicemanager.hpp"
 #include "session.hpp"
 
+#include <algorithm>
 #include <cassert>
 #include <functional>
 #include <memory>
@@ -39,6 +40,7 @@
 #include <pv/devices/hardwaredevice.hpp>
 #include <pv/util.hpp>
 
+using std::any_of;
 using std::bind;
 using std::list;
 using std::map;
@@ -249,24 +251,52 @@ DeviceManager::driver_scan(
 		return driver_devices;
 
 	// Remove any device instances from this driver from the device
-	// list. They will not be valid after the scan.
+	// list. They will not be valid after the scan. Devices that are
+	// currently open (in use by a session) are kept: a driver that holds
+	// its port exclusively cannot probe them again anyway, and dropping
+	// them would orphan the session's still open device.
+	list< shared_ptr<devices::HardwareDevice> > open_devices;
 	devices_.remove_if([&](shared_ptr<devices::HardwareDevice> device) {
-		return device->hardware_device()->driver() == driver; });
+		if (device->hardware_device()->driver() != driver)
+			return false;
+		if (device->is_open()) {
+			open_devices.push_back(device);
+			return false;
+		}
+		return true;
+	});
+
+	// If the scan fails, the kept devices are still what this driver has.
+	driver_devices = open_devices;
 
 	try {
 		// Do the scan
 		auto devices = driver->scan(drvopts);
 
 		// Add the scanned devices to the main list, set display names and sort.
+		list< shared_ptr<devices::HardwareDevice> > new_devices;
 		for (shared_ptr<sigrok::HardwareDevice>& device : devices) {
+			// An open device that the scan found again (drivers that do
+			// not lock their connection) is already in the list.
+			const string conn_id = device->connection_id();
+			const bool listed = !conn_id.empty() &&
+				any_of(open_devices.begin(), open_devices.end(),
+				[&](const shared_ptr<devices::HardwareDevice> &d) {
+					return d->hardware_device()->connection_id() == conn_id; });
+			if (listed)
+				continue;
 			const shared_ptr<devices::HardwareDevice> d(
 				new devices::HardwareDevice(context_, device));
-			driver_devices.push_back(d);
+			new_devices.push_back(d);
 		}
 
-		devices_.insert(devices_.end(), driver_devices.begin(),
-			driver_devices.end());
+		devices_.insert(devices_.end(), new_devices.begin(),
+			new_devices.end());
 		devices_.sort(bind(&DeviceManager::compare_devices, this, _1, _2));
+
+		driver_devices = new_devices;
+		driver_devices.insert(driver_devices.end(), open_devices.begin(),
+			open_devices.end());
 		driver_devices.sort(bind(
 			&DeviceManager::compare_devices, this, _1, _2));
 
diff --git a/pv/devices/hardwaredevice.cpp b/pv/devices/hardwaredevice.cpp
index a3d84d6f..88166507 100644
--- a/pv/devices/hardwaredevice.cpp
+++ b/pv/devices/hardwaredevice.cpp
@@ -140,5 +140,10 @@ void HardwareDevice::close()
 	device_open_ = false;
 }
 
+bool HardwareDevice::is_open() const
+{
+	return device_open_;
+}
+
 } // namespace devices
 } // namespace pv
diff --git a/pv/devices/hardwaredevice.hpp b/pv/devices/hardwaredevice.hpp
index 32f5b644..8ccc65e3 100644
--- a/pv/devices/hardwaredevice.hpp
+++ b/pv/devices/hardwaredevice.hpp
@@ -59,6 +59,11 @@ public:
 
 	void close();
 
+	/**
+	 * Returns true while the device is open, i.e. in use by a session.
+	 */
+	bool is_open() const;
+
 private:
 	const shared_ptr<sigrok::Context> context_;
 	bool device_open_;
-- 
