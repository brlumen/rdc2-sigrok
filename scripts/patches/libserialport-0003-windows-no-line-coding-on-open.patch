From 68b12317673907ce6c47aca9a612db1edd8acb6c Mon Sep 17 00:00:00 2001
From: BrLumen <igflocal@gmail.com>
Date: Sun, 20 Sep 2026 01:10:31 +0700
Subject: [PATCH] windows: Do not read back and rewrite the line coding on open

sp_open() ended with get_config() and set_config() to force a few sane
DCB flags, so every open was a GetCommState() and a SetCommState(). On
a USB CDC port usbser.sys turns each of those into a burst of
GET/SET_LINE_CODING and SET_CONTROL_LINE_STATE control transfers
(about ten in total per open) that nothing here needs: the flags are
fBinary and the error/null/DSR handling, and the baud rate is written
back unchanged.

That burst is fatal to a device whose USB stack cannot take control
traffic. The ChipDip RDC2-0064 (STM32 CDC, ST's USB stack in DMA mode)
stops answering after a few hundred control transfers and lasted about
75 open/close cycles per power cycle from those two calls alone, after
the string descriptor reads had already been taken out of the listing
path.

Leave the DCB alone in sp_open() on Windows. The sane flags move into
set_config(), so they are still enforced whenever the DCB is written --
by sp_set_config() and every individual setter, which all read the DCB
first -- and so does the 9600 fallback for a driver that reports no
baud rate. The 50 ms write buffer used to be sized in set_config() as
well; it is now allocated by a helper that sp_open() calls with the
same default rate, so nonblocking writes keep working on a port that is
never configured.

POSIX is unchanged: there the open path has to switch the tty to raw
mode, and that is a plain ioctl.

Signed-off-by: BrLumen <igflocal@gmail.com>
---
 serialport.c | 89 ++++++++++++++++++++++++++++++++++------------------
 1 file changed, 59 insertions(+), 30 deletions(-)

diff --git a/serialport.c b/serialport.c
index a1e65cd..e43baa7 100644
--- a/serialport.c
+++ b/serialport.c
@@ -53,6 +53,13 @@ static enum sp_return get_config(struct sp_port *port, struct port_data *data,
 static enum sp_return set_config(struct sp_port *port, struct port_data *data,
 	const struct sp_port_config *config);
 
+#ifdef _WIN32
+/* Baud rate assumed for a port that has not been given one. */
+#define SP_DEFAULT_BAUDRATE 9600
+
+static enum sp_return alloc_write_buf(struct sp_port *port, int baudrate);
+#endif
+
 SP_API enum sp_return sp_get_port_by_name(const char *portname, struct sp_port **port_ptr)
 {
 	struct sp_port *port;
@@ -500,8 +507,10 @@ static enum sp_return restart_wait(struct sp_port *port)
 
 SP_API enum sp_return sp_open(struct sp_port *port, enum sp_mode flags)
 {
+#ifndef _WIN32
 	struct port_data data;
 	struct sp_port_config config;
+#endif
 	enum sp_return ret;
 
 	TRACE("%p, 0x%x", port, flags);
@@ -628,30 +637,33 @@ SP_API enum sp_return sp_open(struct sp_port *port, enum sp_mode flags)
 
 #endif
 
-	ret = get_config(port, &data, &config);
+#ifdef _WIN32
+	if (ClearCommError(port->hdl, &errors, &status) == 0)
+		RETURN_FAIL("ClearCommError() failed");
+
+	/*
+	 * Leave the line coding alone. GetCommState() and SetCommState()
+	 * are each a burst of control transfers on a USB CDC port, and
+	 * nothing here depends on their result: the sane DCB flags are
+	 * enforced by set_config() whenever the DCB is written, and a
+	 * device that cares about the line coding gets sp_set_config()
+	 * from its driver anyway. Size the write buffer as for the
+	 * default baud rate that was assumed when the port reported none.
+	 */
+	ret = alloc_write_buf(port, SP_DEFAULT_BAUDRATE);
 
 	if (ret < 0) {
 		sp_close(port);
 		RETURN_CODEVAL(ret);
 	}
+#else
+	ret = get_config(port, &data, &config);
 
-	/*
-	 * Assume a default baudrate if the OS does not provide one.
-	 * Cannot assign -1 here since Windows holds the baudrate in
-	 * the DCB and does not configure the rate individually.
-	 */
-	if (config.baudrate == 0) {
-		config.baudrate = 9600;
+	if (ret < 0) {
+		sp_close(port);
+		RETURN_CODEVAL(ret);
 	}
 
-	/* Set sane port settings. */
-#ifdef _WIN32
-	data.dcb.fBinary = TRUE;
-	data.dcb.fDsrSensitivity = FALSE;
-	data.dcb.fErrorChar = FALSE;
-	data.dcb.fNull = FALSE;
-	data.dcb.fAbortOnError = FALSE;
-#else
 	/* Turn off all fancy termios tricks, give us a raw channel. */
 	data.term.c_iflag &= ~(IGNBRK | BRKINT | PARMRK | ISTRIP | INLCR | IGNCR | ICRNL | IMAXBEL);
 #ifdef IUCLC
@@ -689,12 +701,6 @@ SP_API enum sp_return sp_open(struct sp_port *port, enum sp_mode flags)
 	/* Ignore modem status lines; enable receiver; leave control lines alone on close. */
 	data.term.c_cflag |= (CLOCAL | CREAD);
 	data.term.c_cflag &= ~(HUPCL);
-#endif
-
-#ifdef _WIN32
-	if (ClearCommError(port->hdl, &errors, &status) == 0)
-		RETURN_FAIL("ClearCommError() failed");
-#endif
 
 	ret = set_config(port, &data, &config);
 
@@ -702,6 +708,7 @@ SP_API enum sp_return sp_open(struct sp_port *port, enum sp_mode flags)
 		sp_close(port);
 		RETURN_CODEVAL(ret);
 	}
+#endif
 
 	RETURN_OK();
 }
@@ -1715,6 +1722,24 @@ static enum sp_return set_flow(int fd, struct port_data *data)
 }
 #endif /* USE_TERMIOX */
 
+#ifdef _WIN32
+/* Allocate write buffer for 50ms of data at baud rate. */
+static enum sp_return alloc_write_buf(struct sp_port *port, int baudrate)
+{
+	BYTE *new_buf;
+
+	TRACE("%p, %d", port, baudrate);
+
+	port->write_buf_size = max(baudrate / (8 * 20), 1);
+	new_buf = realloc(port->write_buf, port->write_buf_size);
+	if (!new_buf)
+		RETURN_ERROR(SP_ERR_MEM, "Allocating write buffer failed");
+	port->write_buf = new_buf;
+
+	RETURN_OK();
+}
+#endif
+
 static enum sp_return get_config(struct sp_port *port, struct port_data *data,
 	struct sp_port_config *config)
 {
@@ -1939,10 +1964,19 @@ static enum sp_return set_config(struct sp_port *port, struct port_data *data,
 	DEBUG_FMT("Setting configuration for port %s", port->name);
 
 #ifdef _WIN32
-	BYTE* new_buf;
-
 	TRY(await_write_completion(port));
 
+	/* Sane port settings, whatever the DCB came back with. */
+	data->dcb.fBinary = TRUE;
+	data->dcb.fDsrSensitivity = FALSE;
+	data->dcb.fErrorChar = FALSE;
+	data->dcb.fNull = FALSE;
+	data->dcb.fAbortOnError = FALSE;
+
+	/* Assume a default baudrate if the OS does not provide one. */
+	if (data->dcb.BaudRate == 0)
+		data->dcb.BaudRate = SP_DEFAULT_BAUDRATE;
+
 	if (config->baudrate >= 0) {
 		for (i = 0; i < NUM_STD_BAUDRATES; i++) {
 			if (config->baudrate == std_baudrates[i].value) {
@@ -1954,12 +1988,7 @@ static enum sp_return set_config(struct sp_port *port, struct port_data *data,
 		if (i == NUM_STD_BAUDRATES)
 			data->dcb.BaudRate = config->baudrate;
 
-		/* Allocate write buffer for 50ms of data at baud rate. */
-		port->write_buf_size = max(config->baudrate / (8 * 20), 1);
-		new_buf = realloc(port->write_buf, port->write_buf_size);
-		if (!new_buf)
-			RETURN_ERROR(SP_ERR_MEM, "Allocating write buffer failed");
-		port->write_buf = new_buf;
+		TRY(alloc_write_buf(port, config->baudrate));
 	}
 
 	if (config->bits >= 0)
-- 
2.45.1.windows.1

