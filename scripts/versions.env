#
# Pinned upstream revisions for the OpenLA sigrok stack.
# Sourced by build-macos.sh.  Bump a *_COMMIT together with its *_DATE and
# re-run the build; the script resets the working tree to the pinned commit,
# so a bump is always a clean rebuild of that component.
#
# All four commits below were verified to build and run on:
#   macOS 26.6 (arm64) / Apple clang 21 / Homebrew 6.0 / CMake 4.4 / Qt 6.11.

# libsigrok - core library + hardware drivers + C++ bindings (libsigrokcxx).
# Keep LIBSIGROK_COMMIT in sync with the commit recorded in sigrok/UPSTREAM.txt:
# that is the revision sigrok/libsigrok-build.patch was generated against. If
# they diverge, apply.sh falls back to anchor insertion, which may silently stop
# matching.
LIBSIGROK_URL="https://github.com/sigrokproject/libsigrok.git"
LIBSIGROK_COMMIT="0bc2487778e660f4d3116729b6f4aee2b1996bb0"
LIBSIGROK_DATE="2025-11-20"

# libsigrokdecode - protocol decoders (embeds CPython).
LIBSIGROKDECODE_URL="https://github.com/sigrokproject/libsigrokdecode.git"
LIBSIGROKDECODE_COMMIT="71f451443029322d57376214c330b518efd84f88"
LIBSIGROKDECODE_DATE="2024-10-01"

# sigrok-cli - command line frontend.
SIGROK_CLI_URL="https://github.com/sigrokproject/sigrok-cli.git"
SIGROK_CLI_COMMIT="f44dd91347e7ac797cefc23162b9fcf0b7329f1f"
SIGROK_CLI_DATE="2024-08-26"

# PulseView - Qt GUI frontend.  Needs a master newer than c0676b3 (2025-05-15,
# "Update version range from 2.8 to 3.31.5 to avoid abort"): earlier revisions
# declare cmake_minimum_required(VERSION 2.8.12) without an upper bound, which
# CMake 4.x rejects outright.
PULSEVIEW_URL="https://github.com/sigrokproject/pulseview.git"
PULSEVIEW_COMMIT="af02198741b4e57c9f9b796bd5e6c0f2ae9f2f2b"
PULSEVIEW_DATE="2025-11-10"

# libserialport is NOT built from source by this script: the Homebrew bottle is
# the current upstream release (0.1.2) and libsigrok only needs >= 0.1.1.  The
# revision Homebrew's 0.1.2 corresponds to is recorded here for reference; the
# build does not use it.
LIBSERIALPORT_URL="https://github.com/sigrokproject/libserialport.git"
LIBSERIALPORT_COMMIT="bc8f88ef3399b76da7992a99badebada419d0e19"  # tag libserialport-0.1.2
LIBSERIALPORT_DATE="2024-10-13"

# Homebrew formulae the build is pinned to by name (versions are whatever the
# tap currently ships; recorded here for reference at the time of validation).
#   autoconf 2.73  automake 1.18.1  libtool 2.6.2  pkgconf 3.0.7  cmake 4.4.3
#   glib 2.88.3  libzip 1.11.4  libserialport 0.1.2  libusb 1.0.30
#   libftdi 1.5  hidapi 0.15.0  glibmm@2.66 2.66.10  doxygen 1.18.0
#   boost 1.92.0  qt 6.11.2 (Qt6)  python@3.12 3.12.14
